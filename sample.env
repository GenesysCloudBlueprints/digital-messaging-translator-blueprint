AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""


# Comma-separated list of Genesys Cloud regions this deployment should accept,
# e.g. "mypurecloud.com,mypurecloud.ie,usw2.pure.cloud"
GENESYS_REGIONS="mypurecloud.com"

# For each region listed above, add a matching OAuth Code Authorization client
# registered in that region's org. Build the env var name by upper-casing the
# region and replacing non-alphanumeric characters with underscores, e.g.
# "mypurecloud.com" -> GENESYS_CLIENT_ID_MYPURECLOUD_COM
GENESYS_CLIENT_ID_MYPURECLOUD_COM=""
GENESYS_CLIENT_SECRET_MYPURECLOUD_COM=""